# =============================================================================
# NextGen Digital Studio — Environment Variables
# =============================================================================
# Copy this file to `.env` for local dev, and set the same vars in
# Vercel → Project → Settings → Environment Variables for production.
# All NEXT_PUBLIC_* vars are exposed to the browser — never put secrets there.
# =============================================================================

# ===== Database (PostgreSQL — required for both local & Vercel) =====
# Schema uses provider = "postgresql" (Vercel serverless has read-only FS).
# Options for production:
#   - Vercel Postgres (built-in, easiest)
#   - Neon (https://neon.tech — free tier, serverless Postgres)
#   - Supabase (https://supabase.com — free tier)
# Local dev: run Postgres via Docker:
#   docker run --name nextgen-pg -e POSTGRES_PASSWORD=pg -e POSTGRES_DB=nextgen -p 5432:5432 -d postgres
DATABASE_URL=postgresql://postgres:pg@localhost:5432/nextgen?schema=public
# After setting DATABASE_URL, create tables:  bun run db:push

# ===== Google Apps Script webhook =====
# doPost(e) pushes leads to Google Sheet + sends customer/owner emails
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbzFbb6KNY5bPE46KmckcsJWnl6xEkPWhbCla9HCu2lySblwOFHR-lmMuVYJb2ftlusKjA/exec

# ===== SMTP email (PRIMARY delivery path for customer/owner emails) =====
# Gmail App Password (NOT your regular password). Setup:
#   1. Enable 2-Step Verification on nextgendigitalstudio1@gmail.com
#   2. Google Account → Security → App passwords → "Mail" → generate
#   3. Paste the 16-char password below (no spaces).
# If these are empty, email delivery falls back to the Google Apps Script webhook
# (MailApp.sendEmail, 100/day quota — easy to hit).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nextgendigitalstudio1@gmail.com
SMTP_PASS=
SMTP_FROM=NextGen Digital Studio <nextgendigitalstudio1@gmail.com>

# ===== Admin dashboard =====
NEXT_PUBLIC_ADMIN_PASSWORD=nextgen2025
ADMIN_PASSWORD=nextgen2025

# ===== AI chat provider =====
# Leave GEMINI_API_KEY empty to auto-fallback to z-ai-web-dev-sdk
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=auto

# ===== Site URL =====
NEXT_PUBLIC_SITE_URL=https://nextgendigitalstudio.com

# ===== Analytics — client-side pixels (NEXT_PUBLIC_*) =====
NEXT_PUBLIC_GA4_ID=G-QF7TJBHR7Z
NEXT_PUBLIC_FB_PIXEL_ID=918051034554872
NEXT_PUBLIC_SNAP_PIXEL_ID=7cca67ea-668f-411b-a9ee-5add229d8e0a
NEXT_PUBLIC_TIKTOK_PIXEL_ID=D91TS0RC77UDRLSQ9CKG

# ===== Analytics — server-side Conversions API (optional) =====
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
SNAP_PIXEL_ID=
SNAPCHAT_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
